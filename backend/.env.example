# Plantilla de configuración del backend.
# Copia este archivo a `.env` y ajusta lo que necesites. `.env` NUNCA se sube al repositorio.
# Los valores de abajo coinciden con docker-compose.yml: con ellos funciona sin cambiar nada.

# --- Aplicación ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospitua
DB_USER=hospitua
DB_PASSWORD=hospitua

# --- RabbitMQ ---
RABBITMQ_URL=amqp://hospitua:hospitua@localhost:5672

# --- Módulo 1 (espera máxima de 1 s) y Módulo 3 (espera máxima de 3 s) ---
MODULE1_BASE_URL=http://localhost:4001
MODULE1_TIMEOUT_MS=1000
MODULE3_BASE_URL=http://localhost:4003
MODULE3_TIMEOUT_MS=3000

# --- Verificar disponibilidad: consultas de mantenimiento al Módulo 1 en paralelo ---
MAINTENANCE_CONCURRENCY=5

# --- Reserva directa: reintentos de asignación cuando la base rechaza una habitación por solape ---
ASSIGNMENT_MAX_RETRIES=3

# --- Conciliación de comisiones OTA: máximo de ítems por solicitud del Módulo 3 ---
RECONCILIATION_MAX_ITEMS=500

# --- Calcular tarifa dinámica: cotizaciones al Módulo 3 en paralelo (una por habitación) ---
QUOTE_CONCURRENCY=5

# --- Exportar archivo SIRE (formato del archivo plano de Migración Colombia) ---
# El hotel y la ciudad son obligatorios en producción (sin ellos la aplicación no arranca): ahí van los
# códigos reales del hotel en SIRE. Estos son valores falsos, solo para desarrollo.
SIRE_HOTEL_CODE=DEV-HOTEL
SIRE_CITY_CODE=DEV-CIUDAD
SIRE_FIELD_SEPARATOR=TAB
SIRE_DATE_FORMAT=dd/MM/yyyy
SIRE_LINE_BREAK=CRLF
SIRE_FILE_ENCODING=utf-8
SIRE_MAX_PERIOD_DAYS=366
SIRE_MAX_RECORDS=50000
SIRE_RATE_LIMIT_PER_MINUTE=10
SIRE_MAX_CONCURRENT=3

# --- Channex (Booking.com) ---
# Opcionales para arrancar: si faltan, solo se apagan las tareas de Channex y el resto funciona.
# La clave es un secreto: va solo en tu `.env` local, nunca en el repositorio, la base de datos ni los logs.
CHANNEX_BASE_URL=https://staging.channex.io
CHANNEX_API_KEY=
CHANNEX_PROPERTY_ID=
BOOKING_HOTEL_ID=10485037
BOOKING_COMMISSION_PERCENTAGE=
CHANNEX_SYNC_INTERVAL_SECONDS=30
CHANNEX_ARI_DAYS=90
