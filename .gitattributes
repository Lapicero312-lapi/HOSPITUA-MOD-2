# El código siempre con fin de línea LF, para que Prettier y el CI coincidan en Windows y en Linux.
# Solo aplica al código y a la configuración; los documentos (specs/) no se tocan.
# "auto" deja que Git reconozca los archivos binarios (imágenes, íconos) y no los modifique.
/backend/** text=auto eol=lf
/frontend/** text=auto eol=lf
/.github/** text=auto eol=lf
/package.json text eol=lf
/pnpm-workspace.yaml text eol=lf
/pnpm-lock.yaml text eol=lf
/.nvmrc text eol=lf
/docker-compose.yml text eol=lf
