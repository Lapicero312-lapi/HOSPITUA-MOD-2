op: 391px; margin-left: 350px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: nowrap; ">Marcar habitación como reservada</div></div></div></foreignObject><image x="251" y="384.5" width="198" height="17" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="ggK00FnyNOsSm2zrCPgH-96"><g><rect x="210" y="420" width="280" height="16" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 1px; height: 1px; padding-top: 428px; margin-left: 350px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #3A6EA5; "><div style="display: inline-block; font-size: 10px; font-family: Helvetica; color: light-dark(#3A6EA5, #6f9bcb); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: nowrap; ">REST · POST/PUT · Reactivo</div></div></div></foreignObject><image x="282" y="422.5" width="136" height="14.5" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="ggK00FnyNOsSm2zrCPgH-97"><g><rect x="420" y="492" width="360" height="18" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 1px; height: 1px; padding-top: 501px; margin-left: 600px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: nowrap; ">Consultar liquidación</div></div></div></foreignObject><image x="538.5" y="494.5" width="123" height="17" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="ggK00FnyNOsSm2zrCPgH-98"><g><rect x="420" y="528" width="360" height="16" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 1px; height: 1px; padding-top: 536px; margin-left: 600px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #3A6EA5; "><div style="display: inline-block; font-size: 10px; font-family: Helvetica; color: light-dark(#3A6EA5, #6f9bcb); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: nowrap; ">REST · GET · Reactivo</div></div></div></foreignObject><image x="546.5" y="530.5" width="107" height="14.5" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="ggK00FnyNOsSm2zrCPgH-99"><g><rect x="420" y="552" width="360" height="18" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 1px; height: 1px; padding-top: 561px; margin-left: 600px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: nowrap; ">Consultar tarifa base</div></div></div></foreignObject><image x="540.5" y="554.5" width="119" height="17" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="ggK00FnyNOsSm2zrCPgH-100"><g><rect x="420" y="588" width="360" height="16" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 1px; height: 1px; padding-top: 596px; margin-left: 600px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #3A6EA5; "><div style="display: inline-block; font-size: 10px; font-family: Helvetica; color: light-dark(#3A6EA5, #6f9bcb); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: nowrap; ">REST · GET · Reactivo</div></div></div></foreignObject><image x="546.5" y="590.5" width="107" height="14.5" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="ggK00FnyNOsSm2zrCPgH-101"><g><rect x="420" y="612" width="360" height="18" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 1px; height: 1px; padding-top: 621px; margin-left: 600px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: nowrap; ">Registrar check-out</div></div></div></foreignObject><image x="543.5" y="614.5" width="113" height="17" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="ggK00FnyNOsSm2zrCPgH-102"><g><rect x="420" y="650" width="360" height="16" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 1px; height: 1px; padding-top: 658px; margin-left: 600px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #3A6EA5; "><div style="display: inline-block; font-size: 10px; font-family: Helvetica; color: light-dark(#3A6EA5, #6f9bcb); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: nowrap; ">COLA · Reactivo</div></div></div></foreignObject><image x="560.5" y="652.5" width="79" height="14.5" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="ggK00FnyNOsSm2zrCPgH-103"><g><rect x="0" y="700" width="1200" height="70" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe flex-start; justify-content: unsafe flex-start; width: 1198px; height: 1px; padding-top: 707px; margin-left: 2px;"><div style="box-sizing: border-box; font-size: 0; text-align: left; color: #000000; "><div style="display: inline-block; font-size: 11px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><b>Leyenda</b><br />Línea con tubo = <b>COLA</b> (proceso pesado / asíncrono) · Línea sin tubo = <b>REST</b> (consulta de información)<br /><span style="color: light-dark(rgb(184, 84, 80), rgb(215, 129, 126));"><b>Rojo = Proactivo</b></span> (el módulo emite por iniciativa propia cuando ocurre un evento) · <span style="color: light-dark(rgb(58, 110, 165), rgb(111, 155, 203));"><b>Azul = Reactivo</b></span> (responde a una solicitud o consulta bajo demanda)<br />La flecha va de quien solicita → a quien atiende</div></div></div></foreignObject><image x="2" y="707.5" width="1198" height="55.75" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="6XAAv1AvWRnMayCJ6JkA-3"><g><rect x="1270" y="0" width="560" height="1010" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe flex-start; justify-content: unsafe flex-start; width: 558px; height: 1px; padding-top: 7px; margin-left: 1272px;"><div style="box-sizing: border-box; font-size: 0; text-align: left; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><ul dir="ltr"><li><strong>Proactivo:</strong> el módulo emite el mensaje por iniciativa propia cuando ocurre un evento.</li><br /><li><strong>Reactivo:</strong> el módulo responde a una solicitud, o consulta algo bajo demanda cuando un caso de uso lo necesita.</li><br /><li><strong>REST:</strong> para consultas de información (o cambios de estado simples) que necesitan respuesta inmediata.</li><br /><li><strong>Cola:</strong> para procesos pesados o notificaciones que no necesitan respuesta inmediata.</li><br /></ul><br /><p dir="ltr"><strong>Módulo 1 ↔ Módulo 2</strong></p><br /><ol dir="ltr"><br /><li><strong>Notificación de check-in (M1 → M2): Cola · Proactivo.</strong> Cuando se registra un check-in, Módulo 1 cambia el estado de la habitación y avisa a Módulo 2 por su cuenta. No necesita respuesta inmediata, así que va por cola: Módulo 1 no queda esperando y el mensaje no se pierde si Módulo 2 está caído.</li><br /><li><strong>Notificación de check-out (M1 → M2): Cola · Proactivo.</strong> Al registrar un check-out, Módulo 1 avisa a Módulo 2 para que lo refleje en la reserva. Es un evento que se emite, no una pregunta, y por eso va por cola.</li><br /><li><strong>Datos de huéspedes extranjeros (M1 → M2): Cola · Proactivo.</strong> Procesar y enviar estos datos es más pesado que una consulta normal. Se emite cuando hay un huésped extranjero y va por cola para no frenar el check-in mientras se procesan.</li><br /><li><strong>Consultar reservas (M1 → M2): REST GET · Reactivo.</strong> Módulo 1 necesita verificar las reservas durante check-in, check-out, baja de habitación y bloqueos técnicos. Es una consulta de información que no cambia nada y necesita respuesta inmediata. Módulo 1 solo pregunta cuando un caso de uso lo requiere.</li><br /><li><strong>Consultar inventario de habitaciones (M2 → M1): REST GET · Reactivo.</strong> Módulo 2 pide a Módulo 1 el estado de las habitaciones. Módulo 1 es el dueño del inventario, solo responde, y por ser una consulta va por REST.</li><br /><li><strong>Marcar habitación como reservada (M2 → M1): REST POST/PUT · Reactivo.</strong> Módulo 2 le pide a Módulo 1 que cambie el estado de una habitación a "reservada". Módulo 1 solo actúa cuando se lo piden. Va por REST porque Módulo 2 necesita saber de inmediato si el cambio se pudo hacer, y se usa POST/PUT porque modifica un dato en vez de consultarlo.</li><br /></ol><br /><p dir="ltr"><strong>Módulo 1 ↔ Módulo 3</strong></p><br /><ol dir="ltr" start="7"><br /><li><strong>Consultar liquidación (M1 → M3): REST GET · Reactivo.</strong> Durante el check-out, Módulo 1 consulta a Módulo 3 la liquidación de la estadía. Es una consulta de información con respuesta inmediata y Módulo 3 es el dueño del dato. Si el cálculo resultara pesado, podría pasar a cola.</li><br /><li><strong>Consultar tarifa base (M3 → M1): REST GET · Reactivo.</strong> Módulo 3 necesita la tarifa base de la habitación para calcular la liquidación. Módulo 1 es el dueño de ese dato y solo responde, así que va por REST.</li><br /><li><strong>Registrar check-out (M3 → M1): Cola · Reactivo.</strong> Cuando Módulo 3 termina la liquidación, le pide a Módulo 1 registrar el check-out. Eso dispara varias acciones en cadena (marcar la habitación pendiente a limpieza y notificar a Módulo 2), y Módulo 3 no necesita esperar a que terminen. Módulo 1 solo reacciona al mensaje que recibe. Si Módulo 3 necesitara confirmación inmediata, se cambiaría a REST POST.</li></ol></div></div></div></foreignObject><image x="1272" y="7.5" width="558" height="958" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="kERFXsRTgEOpY0bgXT6b-1"><g><rect x="1940" y="193" width="560" height="227" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe flex-start; justify-content: unsafe flex-start; width: 558px; height: 1px; padding-top: 200px; margin-left: 1942px;"><div style="box-sizing: border-box; font-size: 0; text-align: left; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><div><strong style="background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));">Módulo 2 ↔ Módulo 3</strong></div><div><strong style="background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"><br /></strong></div><div><strong style="background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"><br /></strong></div><div><strong style="background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"><br /></strong></div><ol><li><strong style="background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"><strong style="background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));">Consultar tarifa dinámica (M2 → M3): REST POST · Reactivo.</strong><span style="background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"> Durante la cotización de una reserva o actualización de fechas, Módulo 2 le solicita a Módulo 3 el cálculo exacto del precio según temporada, ocupación y reglas financieras. Es una consulta sincrónica requerida en pantalla antes de confirmar la transacción.</span></strong></li></ol><p></p></div></div></div></foreignObject><image x="1942" y="200.5" width="558" height="143" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="kERFXsRTgEOpY0bgXT6b-3"><g><rect x="680" y="224" width="360" height="18" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 1px; height: 1px; padding-top: 233px; margin-left: 860px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: nowrap; ">Consultar tarifa dinámica</div></div></div></foreignObject><image x="788" y="226.5" width="144" height="17" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="kERFXsRTgEOpY0bgXT6b-4"><g><rect x="680" y="264" width="360" height="16" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 1px; height: 1px; padding-top: 272px; margin-left: 860px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #3A6EA5; "><div style="display: inline-block; font-size: 10px; font-family: Helvetica; color: light-dark(#3A6EA5, #6f9bcb); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: nowrap; ">REST · POST · Reactivo</div></div></div></foreignObject><image x="803.5" y="266.5" width="113" height="14.5" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="GBoEAXeAVCNA0ehtFUWj-3"><g><path d="M 1000 140 L 708.24 140" fill="none" stroke="#3a6ea5" stroke-width="2" stroke-miterlimit="10" pointer-events="stroke" style="stroke: light-dark(rgb(58, 110, 165), rgb(111, 155, 203));"/><path d="M 702.24 140 L 710.24 136 L 708.24 140 L 710.24 144 Z" fill="#3a6ea5" stroke="#3a6ea5" stroke-width="2" stroke-miterlimit="10" pointer-events="all" style="fill: light-dark(rgb(58, 110, 165), rgb(111, 155, 203)); stroke: light-dark(rgb(58, 110, 165), rgb(111, 155, 203));"/></g></g><g data-cell-id="GBoEAXeAVCNA0ehtFUWj-5"><g><rect x="680" y="110" width="360" height="18" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" po